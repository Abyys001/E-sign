# Core
APP_URL=http://localhost:3000
DATABASE_URL=postgres://esign:esign_dev_only@localhost:5433/esign
SESSION_SECRET=            # openssl rand -hex 32
SIGNING_TOKEN_SECRET=      # openssl rand -hex 32
OTP_SECRET=                # openssl rand -hex 32
WEBHOOK_SECRET=            # openssl rand -hex 32 (encrypts per-endpoint secrets at rest)
SETTINGS_ENCRYPTION_KEY=   # openssl rand -hex 32 (AES-256-GCM for stored SMTP/SMS creds)
# Storage: local | s3
CONTRACT_STORAGE_PROVIDER=local
CONTRACT_STORAGE_LOCAL_DIR=./storage-data
CONTRACT_STORAGE_BUCKET=
CONTRACT_STORAGE_REGION=
CONTRACT_STORAGE_ENDPOINT=
CONTRACT_STORAGE_ACCESS_KEY=
CONTRACT_STORAGE_SECRET_KEY=
# SMTP (platform default; orgs may override in Settings)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Bilit.event E-Sign <no-reply@example.com>"
SMTP_REPLY_TO=
# SMS: none | twilio  (none = messages are recorded as NOT_SENT, never faked)
SMS_PROVIDER=none
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
# Outbound webhooks: allow http/private targets. DEV/TEST ONLY; never enable in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Optional malware scanning (clamd host:port)
CLAMAV_HOST=
# Limits
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=200

# Logging: debug | info | warn | error
LOG_LEVEL=info

# First-run bootstrap only (npm run bootstrap); not read by the running app
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_ORG=
ADMIN_PASSWORD=
